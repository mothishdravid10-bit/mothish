# FastAPI Backend Environment Configuration (Copy to .env and fill real values before deploying)

# SQLAlchemy Database URL (SQLite default for single-node; use PostgreSQL in cloud production)
DATABASE_URL=sqlite:///./zeno_accounting.db

# Cryptographic secret key for signing HMAC-SHA256 authentication session tokens (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
AUTH_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# Public HTTPS base URL of the deployed FastAPI service (used in email verification links)
BACKEND_PUBLIC_URL=https://your-zeno-backend.example.com

# Comma-separated CORS origins (set explicitly in production)
CORS_ALLOWED_ORIGINS=*

# SMTP Email Verification Configuration (never hardcode passwords in source)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=ZENO AI <your-sender@gmail.com>
SMTP_USE_TLS=true
